{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDock",
  "version": "0.1.0",
  "identifier": "local.devdock.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1437",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevDock",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#141A24",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1437 ws://127.0.0.1:1437",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/smartone-bridge.ps1": "scripts/smartone-bridge.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Korean"
        ]
      }
    }
  }
}
